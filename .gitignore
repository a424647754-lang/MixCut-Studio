# =========================================================
# MixCut Studio · .gitignore
# 原则：只提交源码与文档，绝不提交模型、运行时、素材、产物
# =========================================================

# ---------- 大体积依赖与运行时（绝对不能提交） ----------
# OpenCLIP 模型权重（约 1.7GB）与 venv（约 3GB）
OpenCLIP/
# 自研引擎：可执行文件、CUDA/NPP 动态库、模型权重（约 2.2GB）
engine/
# ffmpeg / ffprobe 可执行文件（约 434MB）
ffmpeg/
ffmpeg-*/
# 分析缓存与代理缓存（约 2.3GB）
cache/
.preview_proxy/
proxy_cache/

# ---------- 构建与打包产物 ----------
build/
dist/
installer_output/
*.spec
!MixCutStudio.spec
build_out.log
installer_build.log

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 备份与临时文件 ----------
# 本项目的历史备份用 .bak-时间戳 命名
*.bak
*.bak-*
*.orig
*.rej
*.tmp
*.log
!docs/*.log
~$*

# ---------- 媒体素材（版权/体积问题，不进仓库） ----------
*.mp4
*.mov
*.mkv
*.m4v
*.avi
*.webm
*.flv
*.wmv
*.ts
*.mp3
*.wav
*.flac
*.aac
*.m4a
*.cube
*.lrf
*.psd
*.ai

# ---------- 字体 ----------
# 微软雅黑（msyh.ttf）是微软的商业字体，不适合公开分发。
# 程序运行依靠系统自带的 "Microsoft YaHei"，不依赖这个文件；
# 本地或打包时若确实需要自带字体，把它放进 mixcut/ui/fonts/ 即可（不进版本库）。
mixcut/ui/fonts/*.ttf
mixcut/ui/fonts/*.otf
/e3d4fbdd*
/*.ttf
/*.otf

# ---------- 启动图（仅打包版使用，源码运行不需要） ----------
assets/splash_*
assets/*banner*
assets/*brand*
# 程序图标必须保留
!assets/app.png
!assets/*.ico
# 界面设计稿不提交
assets/*.jpg
assets/*.jpeg
/*.png
/*.jpg

# ---------- 工程与个人数据 ----------
*.mixcut
*.autosave
*.mixcut.bak

# ---------- IDE / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本机专属配置 ----------
config/local.*
*.local.json
.env
.env.*
*.pem
*.key

# ---------- 临时分析与诊断脚本（可重新生成） ----------
tests/_*.py
tests/_*.txt

# ---------- 内存监控日志（运行时产生） ----------
tools/mem_logs/
tools/__pycache__/

# ---------- 本地备份目录（供自己回滚，不进版本库） ----------
_backup_*/

# ---------- 工程自动保存备份（运行时产生） ----------
_project_backups/

# ---------- 归档与导出 ----------
*.zip
*.7z
*.rar
*.tar
*.gz
bench_results/
_verify_ui_*/
*_便签取证_*/
_git_history_backup.txt
